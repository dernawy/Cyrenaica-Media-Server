<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Theme.CyrenaicaServer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="20dp">

        <TextView
            android:id="@+id/id_injected_name_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="KITCHEN"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/injected_action_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:gravity="center_horizontal"
            android:text="Watching"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/id_settings_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/word_settings_first_cap_small"
            android:textSize="20sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/id_setting_header_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginStart="20dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="20dp"
        android:text="TextView"
        android:textSize="18sp" />

    <ScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <FrameLayout
                android:id="@+id/id_recording_interface_frame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <ScrollView
                    android:id="@+id/recordingScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:id="@+id/id_on_screen_frame"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginBottom="20dp"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingStart="20dp"
                                android:paddingEnd="20dp">

                                <Switch
                                    android:id="@+id/id_on_screen_info_switch"
                                    android:layout_width="wrap_content"
                                    android:layout_height="48dp"
                                    android:padding="5dp"
                                    android:text="@string/show_video_on_screen_info_switch_label"
                                    app:trackTint="@drawable/switch_thumb"
                                    tools:ignore="UseSwitchCompatOrMaterialXml" />

                                <LinearLayout
                                    android:id="@+id/id_name_date_time_layout"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginTop="10dp"
                                    android:gravity="center"
                                    android:orientation="horizontal">

                                    <RadioButton
                                        android:id="@+id/id_add_device_name_to_motion"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginEnd="10dp"
                                        android:paddingStart="10dp"
                                        android:paddingEnd="10dp"
                                        android:text="@string/word_name_first_cap_small" />

                                    <RadioButton
                                        android:id="@+id/id_add_date_time_to_motion"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="10dp"
                                        android:paddingStart="10dp"
                                        android:paddingEnd="10dp"
                                        android:text="@string/word_date_time_first_cap_small" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/id_show_on_screen_info_helper"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:layout_marginBottom="10dp"
                                    android:gravity="center"
                                    android:text="@string/show_video_on_screen_info_helper_text"
                                    android:textSize="11sp" />

                            </LinearLayout>

                        </FrameLayout>

                        <FrameLayout
                            android:id="@+id/id_video_record_show_logo_frame"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical">

                                <Switch
                                    android:id="@+id/id_show_logo_switch"
                                    android:layout_width="wrap_content"
                                    android:layout_height="48dp"
                                    android:padding="5dp"
                                    android:text="@string/show_logo_label"
                                    app:trackTint="@drawable/switch_thumb"
                                    tools:ignore="UseSwitchCompatOrMaterialXml" />

                                <TextView
                                    android:id="@+id/id_show_logo_helper"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:layout_marginBottom="10dp"
                                    android:gravity="center"
                                    android:text="@string/show_logo_helper_text" />
                            </LinearLayout>

                        </FrameLayout>

                        <FrameLayout
                            android:id="@+id/id_face_detection_recognise_frame"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="20dp"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingStart="20dp"
                                android:paddingEnd="20dp">

                                <Switch
                                    android:id="@+id/id_activate_face_detection"
                                    android:layout_width="wrap_content"
                                    android:layout_height="48dp"
                                    android:padding="5dp"
                                    android:text="@string/activate_face_detect_switch_label"
                                    tools:ignore="UseSwitchCompatOrMaterialXml" />

                                <Switch
                                    android:id="@+id/id_activate_face_recognise"
                                    android:layout_width="wrap_content"
                                    android:layout_height="48dp"
                                    android:padding="5dp"
                                    android:text="@string/activate_face_recognise_switch_label"
                                    tools:ignore="UseSwitchCompatOrMaterialXml" />

                                <TextView
                                    android:id="@+id/id_face_detect_recognise_helper"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:layout_marginBottom="10dp"
                                    android:gravity="center"
                                    android:text="@string/face_detect_recognise_helper"
                                    android:textSize="11sp" />

                            </LinearLayout>

                        </FrameLayout>

                        <FrameLayout
                            android:id="@+id/id_video_record_options_frame"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="20dp"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingStart="20dp"
                                android:paddingEnd="20dp">

                                <Switch
                                    android:id="@+id/id_record_stream_to_application"
                                    android:layout_width="wrap_content"
                                    android:layout_height="48dp"
                                    android:padding="5dp"
                                    android:text="@string/record_stream_to_application_switch_label"
                                    tools:ignore="UseSwitchCompatOrMaterialXml" />

                                <TextView
                                    android:id="@+id/id_record_stream_to_application_helper"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:text="@string/record_stream_to_application_helper"
                                    android:textSize="11sp" />

                                <FrameLayout
                                    android:id="@+id/id_record_on_sd_options_frame"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_marginTop="10dp"
                                    android:visibility="gone">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/id_record_on_sd_section_label"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginBottom="10dp"
                                            android:gravity="center"
                                            android:text="@string/record_on_sd_section_label"
                                            android:textSize="16sp"
                                            android:textStyle="bold" />

                                        <com.google.android.material.textfield.TextInputLayout
                                            android:id="@+id/id_file_name_layout"
                                            style="Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                            android:layout_width="280dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginBottom="10dp"
                                            android:hint="@string/file_name_layout_hint"
                                            android:textColorHint="@color/white"
                                            app:boxBackgroundColor="@color/black"
                                            app:boxBackgroundMode="outline"
                                            app:boxCornerRadiusBottomEnd="4dp"
                                            app:boxCornerRadiusBottomStart="4dp"
                                            app:boxCornerRadiusTopEnd="4dp"
                                            app:boxCornerRadiusTopStart="4dp"
                                            app:boxStrokeColor="@color/text_input_layout_stroke_white"
                                            app:boxStrokeErrorColor="@color/error"
                                            app:counterEnabled="false"
                                            app:counterOverflowTextAppearance="@style/Base.TextAppearance.MaterialComponents.Subtitle2"
                                            app:counterTextAppearance="@style/Base.TextAppearance.MaterialComponents.Subtitle2"
                                            app:errorEnabled="true"
                                            app:errorTextAppearance="@style/Base.TextAppearance.MaterialComponents.Subtitle2"
                                            app:errorTextColor="@color/design_default_color_error"
                                            app:helperText="@string/file_name_layout_helper"
                                            app:hintTextAppearance="@style/MaterialCustomInputLayoutAppearance">

                                            <com.google.android.material.textfield.TextInputEditText
                                                android:id="@+id/id_file_name_input"
                                                android:layout_width="match_parent"
                                                android:layout_height="45dp"
                                                android:inputType="text"
                                                android:paddingTop="10dp"
                                                android:paddingBottom="5dp" />

                                        </com.google.android.material.textfield.TextInputLayout>

                                        <TextView
                                            android:id="@+id/id_choose_record_file_type_section_label"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginBottom="4dp"
                                            android:gravity="center"
                                            android:text="@string/choose_record_file_type_section_label"
                                            android:textSize="16sp"
                                            android:textStyle="bold" />

                                        <LinearLayout
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginBottom="10dp"
                                            android:gravity="center"
                                            android:orientation="horizontal">

                                            <RadioButton
                                                android:id="@+id/id_file_type_mp4_radio"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginEnd="10dp"
                                                android:text="@string/file_type_mp4"
                                                android:textSize="12sp" />

                                            <RadioButton
                                                android:id="@+id/id_file_type_mov_radio"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginStart="10dp"
                                                android:text="@string/file_type_mov"
                                                android:textSize="12sp" />
                                        </LinearLayout>

                                        <FrameLayout
                                            android:id="@+id/id_video_type_mp4_resul"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:visibility="gone">

                                            <LinearLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:layout_gravity="center"
                                                android:gravity="center"
                                                android:orientation="vertical">

                                                <TextView
                                                    android:id="@+id/id_file_type_mp4_choose_resul_label"
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"
                                                    android:gravity="center"
                                                    android:text="@string/file_type_mp4_choose_resul_label"
                                                    android:textSize="16sp"
                                                    android:textStyle="bold" />

                                                <LinearLayout
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"
                                                    android:layout_gravity="center"
                                                    android:gravity="center"
                                                    android:orientation="horizontal">


                                                    <RadioButton
                                                        android:id="@+id/id_file_quality_as_origenal_radio"
                                                        android:layout_width="wrap_content"
                                                        android:layout_height="wrap_content"
                                                        android:text="@string/file_quality_as_origenal"
                                                        android:textSize="12sp" />

                                                    <RadioButton
                                                        android:id="@+id/id_file_quality_hd_radio"
                                                        android:layout_width="wrap_content"
                                                        android:layout_height="wrap_content"
                                                        android:text="@string/file_quality_hd"
                                                        android:textSize="12sp" />

                                                    <RadioButton
                                                        android:id="@+id/id_file_quality_4k_radio"
                                                        android:layout_width="wrap_content"
                                                        android:layout_height="wrap_content"
                                                        android:text="@string/file_quality_4k"
                                                        android:textSize="12sp" />

                                                </LinearLayout>

                                            </LinearLayout>

                                        </FrameLayout>

                                    </LinearLayout>

                                </FrameLayout>

                                <TextView
                                    android:id="@+id/id_file_type_mp4_choose_resul_helper"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:layout_marginBottom="10dp"
                                    android:gravity="center"
                                    android:text="@string/file_type_mp4_choose_resul_helper"
                                    android:textSize="11sp" />
                            </LinearLayout>

                        </FrameLayout>

                        <FrameLayout
                            android:id="@+id/id_video_record_max_time_frame"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="20dp"
                                android:orientation="vertical"
                                android:paddingStart="20dp"
                                android:paddingEnd="20dp">

                                <TextView
                                    android:id="@+id/id_video_max_length_label"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:text="@string/video_max_length_label"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <SeekBar
                                    android:id="@+id/id_video_max_time_length_bar"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginTop="20dp"
                                    android:layout_marginBottom="10dp"
                                    android:max="10"
                                    android:minWidth="100dp"
                                    android:progress="3" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/id_video_max_length_number_place_holder"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginEnd="10dp"
                                        android:text="@string/number_3" />

                                    <TextView
                                        android:id="@+id/id_video_max_length_minutes_place_holder"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/word_minutes_first_cap_small" />

                                </LinearLayout>

                            </LinearLayout>

                        </FrameLayout>

                    </LinearLayout>

                </ScrollView>

            </FrameLayout>

            <FrameLayout
                android:id="@+id/id_watching_interface_frame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

            </FrameLayout>

            <FrameLayout
                android:id="@+id/id_control_buttons_frame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="70dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/id_save_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:text="@string/button_save" />

                    <Button
                        android:id="@+id/id_reset_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:text="@string/button_reset" />

                    <Button
                        android:id="@+id/id_cancel_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/button_cancel" />
                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>