<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/camera_home_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black_overlay"
        android:theme="@style/AppCustomSettingActionBar"
        app:popupTheme="@style/AppCustomSettingActionBarPopup" />

    <FrameLayout
        android:id="@+id/id_upper_control_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp" />

    <FrameLayout
        android:id="@+id/id_camera_video_view_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp">

    </FrameLayout>

    <FrameLayout
        android:id="@+id/id_camera_video_controls_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:foregroundGravity="center"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/id_video_record_button"
                android:layout_width="wrap_content"
                android:layout_height="31dp"
                android:layout_marginStart="20dp"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_media_record_grey_24" />

            <ImageView
                android:id="@+id/id_video_play_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                app:srcCompat="@android:drawable/ic_media_play" />

            <ImageView
                android:id="@+id/id_video_pause_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                app:srcCompat="@android:drawable/ic_media_pause" />

            <ImageView
                android:id="@+id/id_video_stop_button"
                android:layout_width="wrap_content"
                android:layout_height="31dp"
                android:layout_marginStart="20dp"
                app:srcCompat="@drawable/ic_media_stop_24" />

            <ImageView
                android:id="@+id/id_face_recognize_button"
                android:layout_width="wrap_content"
                android:layout_height="31dp"
                android:layout_marginStart="60dp"
                android:layout_marginEnd="20dp"
                android:layout_weight="1"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_recognize_white_24" />
        </LinearLayout>

    </FrameLayout>

    <FrameLayout
        android:id="@+id/id_face_detection_toolbox_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/id_detected_face_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                tools:srcCompat="@tools:sample/avatars" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/id_remove_image_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Button" />

                <Button
                    android:id="@+id/id_recognize_actions_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Button" />

                <Button
                    android:id="@+id/id_save_face_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Button" />
            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
