<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="3dp"
    android:orientation="vertical"
    android:padding="2dp">

    <FrameLayout
        android:id="@+id/id_server_name_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/id_server_home_presence_status_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                app:srcCompat="@drawable/offline_prediction_24" />

            <TextView
                android:id="@+id/id_server_name_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:padding="5dp"
                android:textAlignment="center" />
        </LinearLayout>

    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/id_server_general_info_constraintlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <TextView
            android:id="@+id/id_device_name_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:text="@string/word_name_cap"
            android:textColor="#646060"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/id_device_id_value"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/id_device_name_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="16dp"
            android:text="BEDROOM"
            app:layout_constraintStart_toEndOf="@+id/id_device_name_label"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/id_device_id_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="16dp"
            android:text="@string/word_id_cap"
            android:textColor="#646060"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/id_device_id_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="16dp"
            android:text="0"
            app:layout_constraintStart_toEndOf="@+id/id_device_id_label"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/id_device_type_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:text="@string/word_type_cap"
            android:textColor="#646060"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/id_device_name_value"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/id_device_type_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:text="CONTROLLER"
            app:layout_constraintStart_toEndOf="@+id/id_device_type_label"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/id_device_model_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="8dp"
            android:text="@string/word_model_cap"
            android:textColor="#646060"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/id_device_id_label" />

        <TextView
            android:id="@+id/id_device_model_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="8dp"
            android:text="AI THINKER"
            app:layout_constraintStart_toEndOf="@+id/id_device_model_label"
            app:layout_constraintTop_toBottomOf="@+id/id_device_name_label" />

        <TextView
            android:id="@+id/id_device_wifi_connection_status_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="8dp"
            android:text="@string/word_wifi_status_first_cap_small"
            android:textColor="#646060"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/id_device_model_label" />

        <TextView
            android:id="@+id/id_device_wifi_connection_status_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="11dp"
            android:text="@string/word_disconnected_first_cap_small"
            android:textSize="11sp"
            app:layout_constraintStart_toEndOf="@+id/id_device_wifi_connection_status_label"
            app:layout_constraintTop_toBottomOf="@+id/id_device_model_value" />

        <TextView
            android:id="@+id/id_device_access_status_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="25dp"
            android:layout_marginTop="8dp"
            android:text="Access"
            android:textColor="#646060"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/id_device_model_value"
            app:layout_constraintTop_toBottomOf="@+id/id_device_type_label" />

        <TextView
            android:id="@+id/id_device_access_status_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:layout_marginTop="8dp"
            android:text="Remote"
            app:layout_constraintStart_toEndOf="@+id/id_device_access_status_label"
            app:layout_constraintTop_toBottomOf="@+id/id_device_type_value" />

        <TextView
            android:id="@+id/id_device_espnow_connection_status_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="8dp"
            android:text="@string/word_espnow_status_first_cap_small"
            android:textColor="#646060"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/id_device_wifi_connection_status_value"
            app:layout_constraintTop_toBottomOf="@+id/id_device_access_status_label" />

        <TextView
            android:id="@+id/id_device_espnow_connection_status_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="11dp"
            android:text="@string/word_disconnected_first_cap_small"
            android:textSize="11sp"
            app:layout_constraintStart_toEndOf="@+id/id_device_espnow_connection_status_label"
            app:layout_constraintTop_toBottomOf="@+id/id_device_access_status_value" />
    </androidx.constraintlayout.widget.ConstraintLayout>


</LinearLayout>